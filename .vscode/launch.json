{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Launch",
        "runtimeExecutable": "yarn",
        "runtimeArgs": [
          "debug",
        ],
        "cwd": "${workspaceFolder}"
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Scratchpad",
        "runtimeExecutable": "yarn",
        "runtimeArgs": [
          "scratchpad",
        ],
        "cwd": "${workspaceFolder}"
      },
      {
        "name": "Debug Renderer",
        "port": 9223,
        "request": "attach",
        "type": "chrome",
        "webRoot": "${workspaceFolder}",
        "timeout": 30000
      },
    ],
    "compounds": [
      {
        "name": "Launch & Debug",
        "configurations": ["Launch", "Debug Renderer"],
        "stopAll": true
      }
    ]
}